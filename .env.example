# ============================================================
#  电商客服 Agent 配置
#  只需改下面两行即可接入真实模型；不填 API_KEY 就是本地演示模式。
# ============================================================

# 供应商预设：zhipu / deepseek / dashscope / custom
#   zhipu     智谱 AI     -> https://open.bigmodel.cn/api/paas/v4   glm-4-flash（有免费额度）
#   deepseek  深度求索     -> https://api.deepseek.com/v1            deepseek-chat
#   dashscope 阿里云百炼   -> https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   custom    任意 OpenAI 兼容接口（需要自己填下面的 OPENAI_BASE_URL 和 MODEL_NAME）
PROVIDER=zhipu

# 对应供应商的 API Key，留空则使用本地演示引擎
API_KEY=

# ------------------------------------------------------------
# 只有 PROVIDER=custom 时才需要填写下面两项
# ------------------------------------------------------------
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# MODEL_NAME=your-model-name

# ------------------------------------------------------------
# 知识检索（第二层）
# ------------------------------------------------------------
# 填了 API_KEY 时默认使用供应商的 embedding 模型做语义检索；
# deepseek 官方没有 embedding 接口，会自动降级为 BM25 关键词检索。
# 需要覆盖模型名时再打开下面这行：
# EMBEDDING_MODEL=embedding-3

# ------------------------------------------------------------
# 工具数据源（第三层）
# ------------------------------------------------------------
# mock = 内置演示数据（默认）；http = 调用真实业务接口
# 真实接口的路径、query 参数名、字段 JSONPath 在 config/tools_http.json 配置
# TOOL_BACKEND=mock
# TOOL_API_BASE=https://your-erp.example.com/api
# TOOL_API_KEY=
# TOOL_API_KEY_HEADER=Authorization

# ------------------------------------------------------------
# 可选配置（一般不用改）
# ------------------------------------------------------------
# 默认监听 0.0.0.0（容器平台要求），本地仍用 http://127.0.0.1:8000 访问
# HOST=0.0.0.0
# PORT=8000
# 部署到 Render 等平台时，PORT 由平台注入，无需在这里写死
# TEMPERATURE=0.3
# REQUEST_TIMEOUT=60
# MAX_TOOL_ROUNDS=4
